# Copie este arquivo para .env e preencha com os dados do seu MySQL.
# O .env fica fora do Git (.gitignore): a senha nunca vai para o repositório.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=db_treinos

# Fuso usado para gravar as datas e montar as semanas (segunda a domingo)
DB_TIMEZONE=-03:00

# true mostra no terminal o SQL que o Sequelize gera (bom para estudar as consultas)
DB_LOGGING=false

PORTA=3000
